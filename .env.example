# Copy to .env (never commit .env) or set these in your shell. All are optional.

# Optional LLM intent fallback (Claude). Off unless both are set.
HR_BOT_USE_LLM=0
ANTHROPIC_API_KEY=
HR_BOT_LLM_MODEL=claude-opus-5-5

# Optional passcode for the HRBP flag-review page (unset = no passcode, demo only)
HRBP_VIEW_PASSCODE=

# Optional path overrides
# HR_BOT_DATA_DIR=data
# HR_BOT_LOG_DIR=logs
